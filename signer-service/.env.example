# AntiProfiles HD Wallet & Auto-Sweep Signer Service
# Binds strictly to 127.0.0.1 (never expose publicly)

SIGNER_HOST=127.0.0.1
SIGNER_PORT=3105

# Shared secret between PHP backend (gw_crypto config_json.signer_api_key) and this signer
SIGNER_API_KEY=replace_with_64_char_random_hex_secret

# Optional: You can either set HD_MASTER_MNEMONIC here OR save your Trust Wallet Secret Phrase
# directly in Admin Panel -> Payment Gateways -> In-House Multi-Crypto (stored AES-256-GCM encrypted).
HD_MASTER_MNEMONIC=

# Optional Hardcoded Trust Wallet Treasury Allowlist (leave blank to use Admin Panel Trust Wallet addresses)
TRUST_WALLET_EVM=
TRUST_WALLET_TRON=

# Optional Gas Funder Wallets (for topping up minimal BNB/ETH/TRX when sweeping ERC20/BEP20/TRC20 USDT)
GAS_FUNDER_PRIVATE_KEY_EVM=
GAS_FUNDER_PRIVATE_KEY_TRON=

# Optional TronGrid API Key for higher rate limits
TRONGRID_API_KEY=

# ──────────────────────────────────────────────────────────────────
# AntiProfiles v2.0 — Production Environment Variables Template
# Copy to .env (never commit real secrets to Git)
# ──────────────────────────────────────────────────────────────────

# ── E2E Encrypted Cloud Profile Sync (S3 / Cloudflare R2) ──
ANTIPROFILES_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
ANTIPROFILES_S3_BUCKET=antiprofiles-encrypted-backups
ANTIPROFILES_S3_REGION=auto
ANTIPROFILES_S3_ACCESS_KEY=
ANTIPROFILES_S3_SECRET_KEY=

# ── macOS Code Signing & Apple Notarization ──
CSC_LINK=
CSC_KEY_PASSWORD=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# ── Windows Authenticode Code Signing ──
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# ── Auto-Updater Release Feed ──
ANTIPROFILES_UPDATE_CHANNEL=stable
ANTIPROFILES_UPDATE_URL=https://releases.antiprofiles.com/updates
